# ==========================================
# 1. ZSH Core: Completion, History & Keys
# ==========================================
# Initialize the completion system (MUST be done before zstyle)
autoload -Uz compinit
compinit

# Case-insensitive autocompletion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# History settings
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt APPEND_HISTORY          # Append to history, don't overwrite
setopt SHARE_HISTORY           # Share history across open terminal tabs instantly
setopt HIST_IGNORE_ALL_DUPS    # Don't save duplicates

# Fix Option+Left/Right word jumping on macOS
bindkey "^[[1;3C" forward-word
bindkey "^[[1;3D" backward-word

# ==========================================
# 2. Aliases
# ==========================================
# Modern Replacements (Old -> New)
alias ls="eza --icons=always"
alias ll="eza -la --icons=always --git"
alias cat="bat --style=plain"
alias grep="rg"
alias ps="procs"
alias top="btm"
alias df="duf"
alias du="dust"

# Directory Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

# Quick List Commands (Upgraded to eza for visual consistency)
alias l="eza -lh --icons=always"
alias la="eza -al --icons=always"
alias l.="eza -lhd --icons=always .[^.]*"

# System & Utilities
alias hide="setfile -a V"
alias unhide="setfile -a v"
alias undss="find . -name '.DS_Store' -exec rm -rf {} \;"

# ==========================================
# 3. Custom Functions
# ==========================================
# macOS Keychain helpers
function secret-set() {
  security add-generic-password -U -a "$USER" -s "$1" -w
}

function secret-get() {
  security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null \
    || echo "missing secret: $1 (set with: secret-set $1)" >&2
}

# Create a directory and immediately enter it
function take() {
  mkdir -p "$1"
  cd "$1"
}

# Open man pages in macOS Preview
function pman() {
  man -t "${1}" | open -f -a Preview
}

# ==========================================
# 4. Environment Variables
# ==========================================
export EDITOR=vim
export GPG_TTY=$(tty)

export GEMINI_API_KEY=$(secret-get "GEMINI_API_KEY")

# Make fzf use 'fd' by default (respects .gitignore, ignores .git)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# ==========================================
# 5. Toolchain & Navigation Hooks
# ==========================================
eval "$(fzf --zsh)"
eval "$(mise activate zsh)"
eval "$(zoxide init zsh)"

# ==========================================
# 6. ZSH Plugins (Must be sourced near the end)
# ==========================================
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# Syntax highlighting MUST be the absolute last plugin sourced
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ==========================================
# 7. Prompt (Must be the absolute last line)
# ==========================================
eval "$(starship init zsh)"
